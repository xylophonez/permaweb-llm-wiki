{
  "manifest": "arweave/paths",
  "version": "0.2.0",
  "index": {
    "path": "index.html"
  },
  "fallback": {
    "id": "<FALLBACK_HTML_TX_ID>"
  },
  "paths": {
    "index.html": {
      "id": "<INDEX_HTML_TX_ID>"
    },
    "assets/app.css": {
      "id": "<APP_CSS_TX_ID>"
    },
    "assets/app.js": {
      "id": "<APP_JS_TX_ID>"
    },
    "404.html": {
      "id": "<FALLBACK_HTML_TX_ID>"
    }
  }
}
